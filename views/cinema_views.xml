<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cinema_cinema_list" model="ir.ui.view">
        <field name="name">cinema.cinema.list</field>
        <field name="model">cinema.cinema</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="city"/>
                <field name="tz"/>
                <field name="hall_count"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_cinema_cinema_form" model="ir.ui.view">
        <field name="name">cinema.cinema.form</field>
        <field name="model">cinema.cinema</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_halls" type="object" class="oe_stat_button" icon="fa-video-camera">
                            <field name="hall_count" widget="statinfo" string="Halls"/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Baghdad Mall Cinema"/></h1>
                    </div>
                    <group>
                        <group string="Location">
                            <field name="code"/>
                            <field name="street"/>
                            <field name="city"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>
                        <group string="Operations">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="tz"/>
                            <field name="business_day_cutoff_hour"/>
                            <field name="sales_cutoff_minutes"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cinema_cinema_search" model="ir.ui.view">
        <field name="name">cinema.cinema.search</field>
        <field name="model">cinema.cinema</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="city"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_cinema_cinema" model="ir.actions.act_window">
        <field name="name">Cinemas</field>
        <field name="res_model">cinema.cinema</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
