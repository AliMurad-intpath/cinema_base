<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cinema_movie_kanban" model="ir.ui.view">
        <field name="name">cinema.movie.kanban</field>
        <field name="model">cinema.movie</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" records_draggable="1" group_create="0">
                <field name="state"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full">
                            <field name="poster_256" widget="image" options="{'zoom': true}" class="o_kanban_image_fill_left d-block"/>
                        </aside>
                        <main class="ps-2 ps-md-0">
                            <field name="name" class="fw-bold fs-5"/>
                            <div class="text-muted">
                                <field name="duration_minutes"/> min
                                <span t-if="record.rating.raw_value"> · <field name="rating"/></span>
                            </div>
                            <field name="genre_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <div t-if="record.release_date.raw_value" class="text-muted small">
                                Release: <field name="release_date"/>
                            </div>
                            <div class="small">
                                <field name="upcoming_showtime_count"/> upcoming showtimes
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_cinema_movie_list" model="ir.ui.view">
        <field name="name">cinema.movie.list</field>
        <field name="model">cinema.movie</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'ended'">
                <field name="name"/>
                <field name="release_date"/>
                <field name="duration_minutes"/>
                <field name="rating"/>
                <field name="genre_ids" widget="many2many_tags"/>
                <field name="state" widget="badge" decoration-info="state == 'coming_soon'" decoration-success="state == 'now_showing'"/>
            </list>
        </field>
    </record>

    <record id="view_cinema_movie_form" model="ir.ui.view">
        <field name="name">cinema.movie.form</field>
        <field name="model">cinema.movie</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_coming_soon" string="Coming Soon" type="object" invisible="state != 'draft'"/>
                    <button name="action_set_now_showing" string="Now Showing" type="object" class="btn-primary" invisible="state not in ('draft', 'coming_soon')"/>
                    <button name="action_set_ended" string="End Run" type="object" invisible="state != 'now_showing'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,coming_soon,now_showing,ended"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_showtimes" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="upcoming_showtime_count" widget="statinfo" string="Upcoming"/>
                        </button>
                    </div>
                    <field name="poster" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Movie title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="original_title"/>
                            <field name="original_language"/>
                            <field name="duration_minutes"/>
                            <field name="rating"/>
                        </group>
                        <group>
                            <field name="release_date"/>
                            <field name="genre_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="trailer_url" widget="url"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Synopsis" name="synopsis">
                            <field name="synopsis"/>
                        </page>
                        <page string="Banner" name="banner">
                            <field name="banner" widget="image"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cinema_movie_search" model="ir.ui.view">
        <field name="name">cinema.movie.search</field>
        <field name="model">cinema.movie</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="original_title"/>
                <field name="genre_ids"/>
                <filter name="now_showing" string="Now Showing" domain="[('state', '=', 'now_showing')]"/>
                <filter name="coming_soon" string="Coming Soon" domain="[('state', '=', 'coming_soon')]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_rating" string="Age Rating" context="{'group_by': 'rating'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cinema_movie" model="ir.actions.act_window">
        <field name="name">Movies</field>
        <field name="res_model">cinema.movie</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_cinema_genre" model="ir.actions.act_window">
        <field name="name">Genres</field>
        <field name="res_model">cinema.genre</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_cinema_genre_list" model="ir.ui.view">
        <field name="name">cinema.genre.list</field>
        <field name="model">cinema.genre</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>
</odoo>
